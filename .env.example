# 1) @BotFather-dan aldığın token (MƏCBURİ)
BOT_TOKEN=BURAYA_TOKENI_YAZ

# 2) Botdan kim istifadə edə bilər (Telegram ID-lər, vergüllə). Boş qalsa,
#    bota ilk /start yazan şəxs avtomatik sahib olur.
ALLOWED_USER_IDS=

# 3) turbo.az neçə saniyədən bir yoxlanılsın (minimum 30)
CHECK_INTERVAL_SEC=60

# 4) true  = yalnız yeni yerləşdirilən elanlar
#    false = irəli çəkilən (köhnə, yenidən yuxarı qalxan) elanlar da gəlsin
NEW_ONLY=true

# 5) (İstəyə bağlı — Render/Koyeb kimi pulsuz PaaS serverlər üçün)
#    GitHub Personal Access Token ("gist" icazəsi ilə) yazsan, filtrlərin
#    avtomatik gizli GitHub Gist-də saxlanılır və server restart olanda silinmir.
GITHUB_TOKEN=
GIST_ID=
